% Define the title page

\newcommand{\titlepagemarkup}{%
  \begin{tikzpicture}[remember picture, overlay]
    % --- Right navy panel ---
    \fill[forestGreen] (current page.north east) rectangle
      ([xshift=-0.42\paperwidth]current page.south east);
    % --- Diagonal cut on the panel ---
    \fill[forestGreen]
      ([xshift=-0.42\paperwidth]current page.north east)
      -- ([xshift=-0.42\paperwidth]current page.south east)
      -- ([xshift=-0.36\paperwidth]current page.south east)
      -- ([xshift=-0.36\paperwidth]current page.north east) -- cycle;
    % --- Accent stripe (amber) ---
    \fill[cashyellow]
      ([xshift=-0.36\paperwidth]current page.north east)
      rectangle ([xshift=-0.345\paperwidth]current page.south east);
    % --- Subtle horizontal rules inside the navy panel ---
    \foreach \yy in {0.30,0.32,0.50,0.52,0.70,0.72}{%
      \draw[white, opacity=0.08, line width=0.4pt]
        ([yshift=-\yy\paperheight]current page.north west) ++(0.62\paperwidth,0)
        -- ++(0.38\paperwidth,0);
    }
    % --- Geometric circles on the navy panel ---
    \fill[white, opacity=0.06]
      ([xshift=-0.18\paperwidth, yshift=-0.25\paperheight]current page.north east)
      circle (1.8cm);
    \fill[white, opacity=0.04]
      ([xshift=-0.10\paperwidth, yshift=-0.65\paperheight]current page.north east)
      circle (1.2cm);
    \fill[cashyellow, opacity=0.12]
      ([xshift=-0.25\paperwidth, yshift=-0.50\paperheight]current page.north east)
      circle (0.6cm);
    % --- Thin bottom accent line across full width ---
    \fill[cashyellow]
      (current page.south west) rectangle ([yshift=2pt]current page.south east);
    % --- Small decorative dot grid (top-left corner) ---
    \foreach \dx in {0,1,...,4}{%
      \foreach \dy in {0,1,...,2}{%
        \fill[forestGreen, opacity=0.15]
          ([xshift=10pt+\dx*6pt, yshift=-10pt-\dy*6pt]current page.north west)
          circle (0.8pt);
      }
    }
  \end{tikzpicture}%
}


